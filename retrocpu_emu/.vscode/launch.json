{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "レトロマイコンエミュ Debug",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "runtimeArgs": ["."],
      "preLaunchTask": "electron:build",
      "console": "integratedTerminal",
      "env": {
        "ELECTRON_ENABLE_LOGGING": "1",
        "ELECTRON_RUN_AS_NODE": ""
      }
    }
  ]
}
