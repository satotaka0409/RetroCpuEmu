{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "レトロマイコンエミュ Debug",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder:retrocpu_emu}",
      "runtimeExecutable": "${workspaceFolder:retrocpu_emu}/node_modules/.bin/electron",
      "runtimeArgs": ["."],
      "preLaunchTask": "emu: build",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder:retrocpu_emu}/dist/**/*.js"],
      "env": {
        "ELECTRON_ENABLE_LOGGING": "1",
        "ELECTRON_RUN_AS_NODE": ""
      }
    },
    {
      "name": "Emu: Vitest（現在のファイル）",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder:retrocpu_emu}",
      "program": "${workspaceFolder:retrocpu_emu}/node_modules/vitest/vitest.mjs",
      "args": ["run", "${file}"],
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ]
}
