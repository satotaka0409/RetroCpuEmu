{
  "editor.tabSize": 8,
  "editor.insertSpaces": false,
  "editor.detectIndentation": false,
  "editor.indentSize": "tabSize",
  "files.associations": {
    "*.asm": "mn1613asm",
    "*.s": "mn1613asm",
    "*.mn1613": "mn1613asm",
    "*.mn1610": "mn1613asm",
    "*.tms9995": "mn1613asm",
    "*.inc": "mn1613asm"
  },
  "[mn1613asm]": {
    "editor.tabSize": 8,
    "editor.insertSpaces": false,
    "editor.detectIndentation": false,
    "editor.indentSize": "tabSize",
    "editor.formatOnSave": false,
    "editor.defaultFormatter": "retrocpuemu.retro-asm-editor",
    "files.trimTrailingWhitespace": false,
    "editor.inlineSuggest.enabled": false,
    "editor.quickSuggestions": {
      "other": false,
      "comments": false,
      "strings": false
    },
    "editor.suggestOnTriggerCharacters": false,
    "editor.wordBasedSuggestions": "off",
    "editor.snippetSuggestions": "none"
  },
  "[typescript]": {
    "editor.tabSize": 8,
    "editor.insertSpaces": false,
    "editor.detectIndentation": false,
    "editor.indentSize": "tabSize"
  },
  "[javascript]": {
    "editor.tabSize": 8,
    "editor.insertSpaces": false,
    "editor.detectIndentation": false,
    "editor.indentSize": "tabSize"
  },
  "[json]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.indentSize": "tabSize"
  },
  "[jsonc]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.indentSize": "tabSize"
  }
