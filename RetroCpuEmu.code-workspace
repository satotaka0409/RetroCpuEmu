{
  "folders": [
    {
      "name": "retrocpu_asm_editor",
      "path": "./cursor_expand/retrocpu_asm_editor",
    },
    {
      "name": "debug_expand",
      "path": "./cursor_expand/debug_expand",
    },
    {
      "name": "retrocpu_boot_monitor",
      "path": "./retrocpu_boot_monitor",
    },
    {
      "name": "retrocpu_test_framework",
      "path": "./retrocpu_test_framework",
    },
    {
      "name": "retrocpu_emu_rs",
      "path": "./retrocpu_emu_rs",
    },
    {
      "name": "retrocpu_emu_ts",
      "path": "./retrocpu_emu_ts",
    },
    {
      "name": "retrocpu_asm",
      "path": "./retrocpu_asm",
    },
    {
      "name": "tutorial",
      "path": "./tutorial",
    },
    {
      "name": "cursor rules",
      "path": "./.cursor/rules",
    },
    {
      "name": "root",
      "path": ".",
    },
  ],
  "settings": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.fontSize": 12,
    "editor.inlayHints.enabled": "off",
    "workbench.settings.useSplitJSON": true,
    "git.ignoreLimitWarning": true,
    "editor.inlineSuggest.enabled": true,
    "cursor.cpp.disabledLanguages": ["mn1613asm", "asm"],
    "js/ts.validate.enabled": true,
    "js/ts.format.insertSpaceAfterOpeningAndBeforeClosingEmptyBraces": false,
    "js/ts.updateImportsOnFileMove.enabled": "always",
    "files.trimTrailingWhitespace": false,
    "files.trimTrailingWhitespaceInRegexAndStrings": false,
    "intelephense.diagnostics.enable": true,
    "intelephense.diagnostics.undefinedTypes": true,
    "intelephense.diagnostics.undefinedFunctions": true,
    "intelephense.diagnostics.undefinedConstants": true,
    "intelephense.diagnostics.undefinedMethods": true,
    "intelephense.diagnostics.undefinedProperties": true,
    "intelephense.diagnostics.unusedSymbols": true,
    "intelephense.diagnostics.deprecated": true,
    "intelephense.diagnostics.typeErrors": true,
    "intelephense.files.maxSize": 5000000,
    "intelephense.files.associations": ["**/*.tsx"],
    // プロジェクト全体のインデックスを効かせる
    "intelephense.files.exclude": [
      "**/.*/**",
      "**/css/**",
      "**/img/**",
      "**/js/**",
      "**/node_modules/**",
      "**/storage/**",
      "**/cache/**",
      "**/tests/**",
    ],
    "intelephense.format.enable": true,
    // 検索から除外するフォルダ
    "search.exclude": {
      "**/.*": true,
      "**/node_modules": true,
      "**/dist": true,
      "**/vendor": true,
      "**/tests": true,
      "**/public/js/libraries": true,
    },
    "editor.formatOnSave": false,
    "files.associations": {
      "*.asm": "mn1613asm",
      "*.s": "mn1613asm",
      "*.mn1613": "mn1613asm",
      "*.tms9995": "mn1613asm",
      "*.inc": "mn1613asm",
    },
    "[mn1613asm]": {
      "editor.formatOnSave": false,
      "editor.formatOnPaste": false,
      "editor.formatOnType": false,
      "editor.defaultFormatter": null,
      "editor.codeActionsOnSave": {},
      "editor.tabSize": 8,
      "editor.insertSpaces": false,
      "editor.detectIndentation": false,
      "editor.indentSize": "tabSize",
      "files.trimTrailingWhitespace": false,
      "files.insertFinalNewline": false,
      "editor.inlineSuggest.enabled": false,
      "editor.quickSuggestions": {
        "other": false,
        "comments": false,
        "strings": false,
      },
      "editor.suggestOnTriggerCharacters": false,
      "editor.wordBasedSuggestions": "off",
      "editor.snippetSuggestions": "none",
    },
    "[typescript]": {
      "editor.formatOnSave": true,
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[typescriptreact]": {
      "editor.formatOnSave": true,
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[javascript]": {
      "editor.formatOnSave": true,
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[json]": {
      "editor.formatOnSave": true,
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[jsonc]": {
      "editor.formatOnSave": true,
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[markdown]": {
      "editor.formatOnSave": true,
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[mdc]": {
      "editor.formatOnSave": true,
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[rust]": {
      "editor.defaultFormatter": "rust-lang.rust-analyzer",
      "editor.formatOnSave": true,
    },
    "prettier.documentSelectors": ["**/*.md", "**/*.mdc", "**/*.markdown"],
  },
  "extensions": {
    "recommendations": [
      "MS-CEINTL.vscode-language-pack-ja",
      "ms-vscode-remote.vscode-remote-extensionpack",
      "ms-azuretools.vscode-docker",
      "ms-azuretools.vscode-containers",
      "esbenp.prettier-vscode",
      "rodrigovallades.es7-react-js-snippets",
      "donjayamanne.githistory",
      "mhutchie.git-graph",
      "ms-edgedevtools.vscode-edge-devtools",
      "pranaygp.vscode-css-peek",
      "dbaeumer.vscode-eslint",
      "alefragnani.Bookmarks",
      "tomoki1207.pdf",
      "rust-lang.rust-analyzer",
      "vadimcn.vscode-lldb",
      "christian-kohler.npm-intellisense",
      "dbaeumer.vscode-eslint",
      "tamasfe.even-better-toml",
    ],
    "unwantedRecommendations": [
      "13xforever.language-x86-64-assembly",
      "dan-c-underwood.arm",
    ],
  },
}
