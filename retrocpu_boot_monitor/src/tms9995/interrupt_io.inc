; 割り込み関連 CRU 定義
; 根拠: TMS9995_CPUボードメモリ_IOマップ.mdc
; INT1 = ハンドシェイク、INT2 = ブレイク / ステップ、INT3 = 内蔵タイマー

INTERRUPT_BUSY_BIT	.equ	0x0020

; INT1 要因（Bit0-1）。タイマーは内蔵レベル3のため載せない
INT1_CAUSE_BASE		.equ	0x0021
INT1_CAUSE_HSHK		.equ	1
INT1_CAUSE_MASK		.equ	0x0003

; INT2 要因（Bit0）
INT2_CAUSE_BIT		.equ	0x0023
INT2_CAUSE_BREAK	.equ	0
INT2_CAUSE_STEP		.equ	1

; ハンドシェイク制御
HSHK_OUT_REQ_BIT	.equ	0x0024
HSHK_ENA_BIT		.equ	0x0025
HSHK_OUT_DENA_BIT	.equ	0x0026
HSHK_IN_DACK_BIT	.equ	0x0027
HSHK_IN_REQ_BIT		.equ	0x0028
HSHK_IN_DENA_BIT	.equ	0x0029
HSHK_IN_DACK_IN_BIT	.equ	0x002A
HSHK_OUT_DACK_BIT	.equ	0x002B

HSHK_OUT_DATA_BASE	.equ	0x0030
HSHK_IN_DATA_BASE	.equ	0x0038

; CPLD 比較器（CRU）
IO_BREAK_NUM_OUT	.equ	0x0040
IO_BREAK_HIT_IN		.equ	0x0043
IO_BREAK_ENA		.equ	0x0046
IO_BREAK_MEMIO		.equ	0x0047
IO_BREAK_RDWR		.equ	0x0048
IO_BREAK_ADDR		.equ	0x0050
IO_BREAK_PREV		.equ	0x0060

; ステップ実行ワンショット
IO_STEP_BRK_ENA		.equ	0x0068
IO_STEP_BRK_COM		.equ	0x0070
; 既定トリガ: RTWP
STEP_BRK_COM_RTWP	.equ	0x0380
