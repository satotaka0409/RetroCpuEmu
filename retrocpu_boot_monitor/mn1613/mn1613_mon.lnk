; mn1613_mon.lnk — SDCC 付属 sdld の領域配置（ラッパが .lnk を生成して sdld -f する）
;
; -i -m -y -w
; -b _SYS_PAGE0 = 0x0010
; -b _USR_PAGE0 = 0x0080
; -b _VECTOR = 0x0000
; -b _BIOS = 0x0000
; （_CODE は 1 本目の map の s__BIOS+l__BIOS を 2 本目の -b に書く。配置は sdld）
; （_DATA / _WORK も同様に l__CODE / l__DATA から -b）
; main.rel を先頭に並べる。
