{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"],
    "baseUrl": "../retrocpu_test_framework",
    "paths": {
      "@emu/*": ["../retrocpu_emu/src/*"],
      "@asm/*": ["../retrocpu_asm/src/main/*"]
    }
  },
  "include": [
    "../retrocpu_test_framework/src/**/*.ts",
    "../retrocpu_test_framework/test/**/*.ts",
    "../retrocpu_boot_monitor/mn1613/test/**/*.ts"
  ]
}
